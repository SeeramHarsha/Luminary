server {
  listen ${PORT};
  root /usr/share/nginx/html;
  add_header Cache-Control "no-cache";

  # API, media and logo go to the backend Cloud Run service (same address for the visitor => cookies, QR and offline just work)
  location ~ ^/(api|media|brand)/ {
    resolver 169.254.169.254 valid=30s ipv6=off;
    set $upstream "${BACKEND_URL}";
    proxy_pass $upstream;
    proxy_ssl_server_name on;
    proxy_set_header Host ${BACKEND_HOST};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;
    client_max_body_size 64m;
    proxy_read_timeout 3600s;
  }

  location /fonts/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
  location /icons/ { add_header Cache-Control "public, max-age=86400"; }

  # app shell: / and /q/CODE and /#/admin all load index.html
  location / { try_files $uri /index.html; }
}
